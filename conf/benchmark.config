/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Benchmark instrumentation
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Adds task-level timing without changing process resources or pipeline outputs.
----------------------------------------------------------------------------------------
*/

process {
    beforeScript = { """
echo "PGSC_BENCHMARK_TASK_START epoch=\$(date +%s.%N) iso=\$(date --iso-8601=ns) host=\$(hostname) pid=\$\$"
echo "PGSC_BENCHMARK_TASK_RESOURCES cpus=${task.cpus} memory=${task.memory} attempt=${task.attempt}"
df -h . || true
""" }

    afterScript = '''
echo "PGSC_BENCHMARK_TASK_END epoch=$(date +%s.%N) iso=$(date --iso-8601=ns) host=$(hostname) pid=$$"
df -h . || true
'''
}

trace {
    enabled = true
    fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,vol_ctxt,inv_ctxt,attempt,workdir,container,script'
}
